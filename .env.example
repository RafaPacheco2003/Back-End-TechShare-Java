# Copia este archivo a .env y rellena los valores locales para pruebas E2E
# NO subir .env al repositorio. .gitignore ya ignora .env

# JWT HMAC secret (mínimo 32 caracteres recomendados)
JWT_SECRET=tu_secreto_super_seguro_de_al_menos_32_caracteres

# DB para desarrollo local (si usas docker-compose)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/techmate_inventory
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=admin1

# Frontend origin para CORS (ejemplo local)
FRONTEND_ORIGIN=http://localhost:3000

# Otros valores de entorno necesarios (mail, storage, etc.)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=example
MAIL_PASSWORD=change_me
STORAGE_LOCATION=./uploaded-images
